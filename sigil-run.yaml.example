# Copy this file to sigil-run.yaml or pass it explicitly with:
#   sigil run start --run-config ./sigil-run.yaml
# Environment variables prefixed with SIGIL_RUN_ override file values.

system_prompt_append: |
  Answer only with the final result requested by the prompt.

# Choose exactly one of `prompt` or `prompt_template`.
prompt_template: |
  {{.question}}

# Choose exactly one of `context` or `context_template`.
context_template: |
  # External Context
  {{.external_context}}

llm:
  provider: openai
  model: gpt-5.3-codex
  gateway: openrouter
  reasoning:
    # This example keeps reasoning disabled because the fallback pricing block
    # below does not include a separate reasoning-token price.
    enabled: false
    effort: medium
  openrouter:
    base_url: https://openrouter.ai/api/v1
    request_timeout_ms: 30000
    api_key_env: OPENROUTER_API_KEY

rlm:
  enabled: true
  max_depth: 3

guardrails:
  max_steps_per_node: 64
  max_total_steps_per_run: 256
  max_run_duration_ms: 1200000
  max_consecutive_step_failures: 6

  # Optional cumulative run budgets.
  max_total_tokens: 1000000
  max_total_cost_usd: "5.00"

accounting:
  # Update this identifier when you refresh the fallback price card.
  pricing_version: openrouter-2026-03-07
  fallback_pricing:
    openai:
      gpt-5.3-codex:
        input_microusd_per_million_tokens: 1750000
        output_microusd_per_million_tokens: 14000000
